        注意：添加空实现类：NoneEvent、NoneChannel，其仅记录日志。
        问题：兼容性 -> 重载.
    interface Channel<T> {
        void send(T value);
        T receive();
    }

5. Downloader 接口完善：
    interface Downloader {
        DownloaderHandle submit(Task task);
        String readString(WebURL url) throws IOException;
    }
    interface Task {
        void execute();
    }

    // 一个任务一个文件下载.
    final class DownloaderTask implements Task {
        Path targetOutput;
        WebURL url;
        String sha1;  // 自动检查
        boolean async; // 是否异步.
        boolean breakpointRetry; // 断点是否自连.
        List<WebURL> mirrorUrls; // 镜像源
        boolean useMirrorFirst; // 默认使用镜像源.
        boolean usePart; // 分段下载.

        @Override void execute();
        static DownloaderTask of(xxx);
    }
    interface DownloaderHandle {
        DownloaderProgress getProgress();
        void cancel();
        CompletableFuture<Void> getFuture();
    }
    interface Progress {

    }
    class DownloaderProgress implements Progress {
        long downloadedBytes;
        long totalBytes;
        double speed-bps;
        String currentUrl;
        double getRatio(){
            xxxxxxx
        }
    }
